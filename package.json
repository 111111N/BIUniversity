{
  "name": "bi-system",
  "private": true,
  "scripts": {
    "dev": "corepack pnpm --filter frontend run dev",
    "build": "corepack pnpm --filter frontend run build",
    "typecheck": "corepack pnpm --filter frontend run typecheck",
    "lint": "corepack pnpm --recursive run lint",
    "format": "corepack pnpm --recursive run format",
    "test": "corepack pnpm --recursive run test",
    "clean": "rimraf frontend/dist backend/dist node_modules",
    "install:all": "corepack pnpm install --recursive"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "rimraf": "^6.0.0"
  }
}
