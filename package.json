{
  "name": "bi-system",
  "private": true,
  "scripts": {
    "dev": "concurrently -n FRONT,BACK -c cyan,magenta \"pnpm --filter frontend dev\" \"pnpm --filter backend dev\"",
    "lint": "pnpm --recursive run lint",
    "format": "pnpm --recursive run format",
    "test": "pnpm --recursive run test",
    "clean": "rimraf frontend/dist backend/dist node_modules",
    "install:all": "pnpm install --recursive"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "rimraf": "^6.0.0"
  }
}
